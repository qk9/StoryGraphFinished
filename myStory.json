        "OutsideDoor2": {
            "Body": "You're outside the door. The spirit world stretches infinitely out before you in all its splendor, but your mind is clear. You must keep moving toward your goal.",
            "ShowTime": "",
            "Choices": [
                {
                    "Text": "Go inside",
                    "Target": "Door2"
                },
                {
                    "Text": "Go around the house",
                    "Target":"OutsideTable2"
